<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f5f5f7">
  <title>{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}</title>
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}">
  <meta property="og:type" content="website">
  {% if socialImage %}<meta property="og:image" content="{{ site.url }}{{ socialImage | url }}">{% endif %}
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <script src="https://kit.fontawesome.com/ede7ed9b9e.js" crossorigin="anonymous"></script>
  <script src="{{ '/assets/theme.js' | url }}" defer></script>
</head>
<body class="{{ bodyClass or '' }}">
  <header class="page-top white">
    <div class="character-header">
      <button class="theme-trigger dotti" type="button" data-theme="theme-dotti">
        <img class="header-character dotti" src="{{ '/assets/images/dotti.png' | url }}" alt="">
      </button>
      <div class="header-center">
        <a class="series-logo" href="{{ '/comics/' | url }}">
          <img src="{{ '/assets/images/header.png' | url }}" alt="">
        </a>
        <nav class="menu">
          <a href="{{ '/comics/all/' | url }}">all</a>
          <a href="{{ '/links/' | url }}">links</a>
          <a href="{{ '/extras/' | url }}">extras</a>
          <a href="{{ '/other-comics/' | url }}">other comics</a>
        </nav>
      </div>
      <button class="theme-trigger skratchi" type="button" data-theme="theme-skratchi">
        <img class="header-character skratchi" src="{{ '/assets/images/skratchi.png' | url }}" alt="">
      </button>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
</body>
</html>
