---
layout: layouts/base.njk
pagination:
  data: geckowo_doodles
  size: 1
  alias: doodle
  addAllPagesToCollections: true
permalink: "geckowo/doodles/{{ doodle.slug }}/index.html"
bodyClass: ""
eleventyComputed:
  title: "Geckowo Doodles{% if doodle.title %} - {{ doodle.title }}{% endif %}"
  description: "Doodles by Claire (@geckowo on Twitter/X)!"
  ogImage: "{{ doodle.ogImage }}"
  twitterImage: "{{ doodle.twitterImage }}"
---
{% set doodlesList = geckowo_doodles %}
{% set firstDoodle = doodlesList[0] %}
{% set latestDoodle = doodlesList[doodlesList.length - 1] %}
{% set currentIndex = -1 %}
{% for d in doodlesList %}
  {% if d.slug == doodle.slug %}
    {% set currentIndex = loop.index0 %}
  {% endif %}
{% endfor %}
{% if currentIndex > 0 %}
  {% set prevDoodle = doodlesList[currentIndex - 1] %}
{% endif %}
{% if currentIndex + 1 < doodlesList.length %}
  {% set nextDoodle = doodlesList[currentIndex + 1] %}
{% endif %}
{% set backHref = '/' %}
{% set desktopBack = { href: '/', label: 'Back to Home', icon: 'fas fa-chevron-left', iconStyle: 'font-size:14px;margin-right:3px;' } %}
<div class="page-top white goldenchaos-btt">
  {% include "nav.njk" %}
</div>
<div class="content index page" id="comic-title">
  <h1 id="comics" class="title" style="text-align:center;margin:0;text-transform:none;">
    {% if doodle.title %}{{ doodle.title }}{% endif %}
  </h1>
</div>
<div class="content page" style="text-align:center;">
  <img src="{{ doodle.image }}" alt="{{ doodle.alt }}" class="comic-img">
  <div class="segmented-control">
    <a{% if currentIndex == 0 %} disabled{% else %} href="/geckowo/doodles/{{ firstDoodle.slug }}/" onclick="if(typeof gtag!=='undefined')gtag('event','comic_navigation',{'event_category':'engagement','event_label':'first'})"{% endif %}>
      <center>
        <i class="fa-solid fa-fast-backward"></i>
        First
      </center>
    </a>
    <a{% if prevDoodle %} href="/geckowo/doodles/{{ prevDoodle.slug }}/" onclick="if(typeof gtag!=='undefined')gtag('event','comic_navigation',{'event_category':'engagement','event_label':'previous'})"{% else %} disabled{% endif %}>
      <center>
        <i class="fa-solid fa-backward"></i>
        Previous
      </center>
    </a>
    <a href="/geckowo/doodles/all/" onclick="if(typeof gtag!=='undefined')gtag('event','comic_navigation',{'event_category':'engagement','event_label':'view_all'})">
      <center>
        <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" style="width: 26px; height: 26px; display: block; margin: 0 auto 8px;">
          <rect x="2" y="2" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="11" y="2" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="20" y="2" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="2" y="11" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="11" y="11" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="20" y="11" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="2" y="20" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="11" y="20" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
          <rect x="20" y="20" width="7" height="7" rx="1.5" ry="1.5" fill="currentColor"/>
        </svg>
        View All
      </center>
    </a>
    <a{% if nextDoodle %} href="/geckowo/doodles/{{ nextDoodle.slug }}/" onclick="if(typeof gtag!=='undefined')gtag('event','comic_navigation',{'event_category':'engagement','event_label':'next'})"{% else %} disabled{% endif %}>
      <center>
        <i class="fa-solid fa-forward"></i>
        Next
      </center>
    </a>
    <a{% if doodle.slug == latestDoodle.slug %} disabled{% else %} href="/geckowo/doodles/" onclick="if(typeof gtag!=='undefined')gtag('event','comic_navigation',{'event_category':'engagement','event_label':'latest'})"{% endif %}>
      <center>
        <i class="fa-solid fa-fast-forward"></i>
        Latest
      </center>
    </a>
  </div>
  <div class="segmented-control">
    <a id="copyBtn" onclick="copyDoodleLink()" style="cursor:pointer;">
      <center>
        <i class="fa-solid fa-link"></i>
        Copy Doodle Link
      </center>
    </a>
    <a id="copyImgBtn" onclick="copyDoodleImageLink()" style="cursor:pointer;">
      <center>
        <i class="fa-solid fa-image"></i>
        Copy Doodle Image Link
      </center>
    </a>
  </div>
</div>
<footer>
  <span>&copy; 2024-<script>document.write(new Date().getFullYear())</script> Claire <a href="https://x.com/geckowo" target="_blank" class="geckowo-footer-link">@geckowo</a></span>
</footer>
<script>
async function copyWithFallback(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch (err) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch (copyErr) {
      console.error('Copy failed', copyErr);
    }
    document.body.removeChild(textarea);
    return ok;
  }
}

function showCopied(buttonId, success) {
  const btn = document.getElementById(buttonId);
  if (!btn) return;
  const originalHTML = btn.innerHTML;
  btn.innerHTML = success ? '<center><i class="fa-solid fa-check"></i>Copied!</center>' : '<center><i class="fa-solid fa-xmark"></i>Copy failed</center>';
  setTimeout(() => {
    btn.innerHTML = originalHTML;
  }, 2000);
}

async function copyDoodleLink() {
  const link = window.location.origin + '/geckowo/doodles/{{ doodle.slug }}/';
  const ok = await copyWithFallback(link);
  showCopied('copyBtn', ok);
  if (ok && typeof gtag !== 'undefined') {
    gtag('event', 'copy_link', {
      'event_category': 'engagement',
      'event_label': 'comic_link'
    });
  }
}

async function copyComicImageLink() {
  const fullURL = new URL('{{ doodle.image }}', window.location.origin).href;
  const ok = await copyWithFallback(fullURL);
  showCopied('copyImgBtn', ok);
  if (ok && typeof gtag !== 'undefined') {
    gtag('event', 'copy_link', {
      'event_category': 'engagement',
      'event_label': 'comic_image_link'
    });
  }
}
</script>
