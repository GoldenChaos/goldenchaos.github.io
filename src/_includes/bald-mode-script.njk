<script>
(function() {
  const STORAGE_KEY = 'gc-bald-mode';
  const KONAMI = ['arrowup','arrowup','arrowdown','arrowdown','arrowleft','arrowright','arrowleft','arrowright','b','a'];
  let buffer = [];

  function applyBaldMode(enabled) {
    const imgs = document.querySelectorAll('[data-normal-image]');
    imgs.forEach((img) => {
      const normal = img.getAttribute('data-normal-image');
      const bald = img.getAttribute('data-bald-image');
      if (enabled && bald) {
        if (img.getAttribute('src') !== bald) {
          img.setAttribute('src', bald);
        }
      } else if (normal) {
        if (img.getAttribute('src') !== normal) {
          img.setAttribute('src', normal);
        }
      }
    });
    document.documentElement.dataset.baldMode = enabled ? 'on' : 'off';
  }

  function setBaldMode(enabled) {
    sessionStorage.setItem(STORAGE_KEY, enabled ? 'on' : 'off');
    applyBaldMode(enabled);
  }

  function handleKeydown(event) {
    buffer.push(String(event.key).toLowerCase());
    if (buffer.length > KONAMI.length) {
      buffer.shift();
    }
    if (buffer.join(',') === KONAMI.join(',')) {
      const next = sessionStorage.getItem(STORAGE_KEY) !== 'on';
      setBaldMode(next);
    }
  }

  document.addEventListener('keydown', handleKeydown, true);
  document.addEventListener('DOMContentLoaded', () => {
    const enabled = sessionStorage.getItem(STORAGE_KEY) === 'on';
    applyBaldMode(enabled);
  });
})();
</script>
