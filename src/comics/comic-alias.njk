---
pagination:
  data: comics
  size: 1
  alias: comic
  addAllPagesToCollections: false
permalink: "comics/{{ comic.comicId }}/index.html"
eleventyExcludeFromCollections: true
layout: null
---
<!doctype html>
<html lang="en">
<head>
  {% set primary = comic.comicId ~ '-' ~ comic.slug %}
  {% set pageTitle = "GoldenChaos Comics - #" ~ comic.number ~ " " ~ comic.title %}
  {% set pageDescription = "Comics by Jess Rappaport!" %}
  {% set ogImage = comic.ogImage or comic.image %}
  {% set twitterImage = comic.twitterImage or ogImage %}
  {% set canonicalUrl = "/comics/" ~ primary ~ "/" %}
  {% set aliasUrl = "/comics/" ~ comic.comicId ~ "/" %}
  <meta charset="utf-8">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:alt" content="{{ comic.alt or pageTitle }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ twitterImage }}">
  <meta name="twitter:image:alt" content="{{ comic.alt or pageTitle }}">
  <meta http-equiv="refresh" content="0; url={{ canonicalUrl }}">
  <script>window.location.replace('{{ canonicalUrl }}');</script>
</head>
<body>
  <p>Redirecting to <a href="{{ canonicalUrl }}">{{ canonicalUrl }}</a>...</p>
  <p>If you are not redirected, open <a href="{{ aliasUrl }}">{{ aliasUrl }}</a>.</p>
</body>
</html>
